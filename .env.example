# MySQL
MYSQL_ROOT_PASSWORD=sun_admin_root_password
MYSQL_DATABASE=sun_admin
MYSQL_USER=sun_admin
MYSQL_PASSWORD=sun_admin_password
MYSQL_PORT=3306

# Backend
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
API_PORT=5000
ConnectionStrings__Default=Data Source=mysql;Port=3306;User ID=sun_admin;Password=sun_admin_password;Initial Catalog=sun_admin;Charset=utf8mb4;SslMode=none;Min pool size=1

# Database initialization
Database__SyncStructure=true
Database__SeedData=true

# JWT
Jwt__Issuer=sun-admin
Jwt__Audience=sun-admin
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__AccessTokenMinutes=120

# Initial administrator
Seed__AdminUserName=admin
Seed__AdminEmail=admin@sun-admin.local
Seed__AdminPassword=ChangeMe_123456

# Frontend
VITE_API_BASE_URL=
